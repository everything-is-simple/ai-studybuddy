# AI StudyBuddy 环境变量（复制为 .env.local 后填入真实值）
# 运行数据根目录
APP_DATA_ROOT=I:\ai-studybuddy-data

# 后端服务
BACKEND_PORT=3000
BACKEND_HOST=127.0.0.1
# 可选追加本机前端 Origin，逗号分隔；仅允许带显式端口的 http loopback Origin
CONFIG_ALLOWED_ORIGINS=

# OCR 子进程配置（可选）
PYTHON_PATH=python
OCR_TIMEOUT_MS=60000

# AI Provider（中转 GPT/Claude）
# 多 Provider 轮询链：JSON 数组，按 priority 升序尝试；留空则 fallback 到单 Provider 配置
AI_PROVIDERS=
AI_TIMEOUT_MS=60000
# 单 Provider 向后兼容配置（AI_PROVIDERS 为空时使用）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# QQ SMTP 邮件
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_AUTH_CODE=
SMTP_TO=

# 飞书 Webhook
FEISHU_WEBHOOK_URL=
