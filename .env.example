# AI StudyBuddy 环境变量（复制为 .env.local 后填入真实值）
# 运行数据根目录
APP_DATA_ROOT=C:\Users\YOUR_NAME\AppData\Local\AIStudyBuddy\data

# 后端服务
BACKEND_PORT=3000
BACKEND_HOST=127.0.0.1
# 可选追加本机前端 Origin，逗号分隔；仅允许带显式端口的 http loopback Origin
CONFIG_ALLOWED_ORIGINS=

# OCR 子进程配置（可选）
PYTHON_PATH=C:\Users\YOUR_NAME\AppData\Local\AIStudyBuddy\runtime\venv\Scripts\python.exe
OCR_TIMEOUT_MS=60000
OCR_TEMP_ROOT=C:\Users\YOUR_NAME\AppData\Local\AIStudyBuddy\tmp\ocr
OCR_CACHE_ROOT=C:\Users\YOUR_NAME\AppData\Local\AIStudyBuddy\models\rapidocr

# 生产前端静态目录（开发模式留空）
FRONTEND_STATIC_ROOT=

# DOCX/PPTX ZIP 安全阈值（可选）
DOCX_ZIP_MAX_ENTRIES=10000
DOCX_ZIP_MAX_ENTRY_SIZE_BYTES=52428800
DOCX_ZIP_MAX_TOTAL_SIZE_BYTES=104857600
DOCX_ZIP_MAX_DOCUMENT_XML_SIZE_BYTES=20971520
PPTX_ZIP_MAX_ENTRIES=10000
PPTX_ZIP_MAX_ENTRY_SIZE_BYTES=52428800
PPTX_ZIP_MAX_TOTAL_SIZE_BYTES=104857600
PPTX_ZIP_MAX_SLIDE_XML_SIZE_BYTES=20971520

# AI Provider（OpenAI-compatible，含自定义中转站）
# 多 Provider fallback：JSON 数组，按 priority 升序失败切换并执行冷却；留空则 fallback 到单 Provider 配置
AI_PROVIDERS=
AI_TIMEOUT_MS=60000
# 单 Provider 向后兼容配置（AI_PROVIDERS 为空时使用）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# QQ SMTP 邮件
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_AUTH_CODE=
SMTP_TO=

# 飞书 Webhook
FEISHU_WEBHOOK_URL=

# 前端开发/构建（通过进程环境或 packages/frontend/.env.local 设置；根目录 .env.local 不会被 Vite 读取）
VITE_API_BASE_URL=
