# AI StudyBuddy 环境变量（复制为 .env.local 后填入真实值）
# 运行数据根目录
APP_DATA_ROOT=I:\ai-studybuddy-data

# 后端服务
BACKEND_PORT=3000
BACKEND_HOST=127.0.0.1

# OCR 子进程配置（可选）
PYTHON_PATH=python
OCR_TIMEOUT_MS=60000

# AI Provider（中转 GPT/Claude）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# QQ SMTP 邮件
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_AUTH_CODE=
SMTP_TO=

# 飞书 Webhook
FEISHU_WEBHOOK_URL=
