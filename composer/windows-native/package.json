{
  "name": "ai-studybuddy-windows-native-smoke",
  "version": "0.7.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test:sqlite": "node --test 01-sqlite/smoke-test/sqlite.test.js",
    "test:storage": "node --test 02-local-storage/smoke-test/storage.test.js",
    "test:jobs": "node --test 03-job-worker/smoke-test/jobs.test.js",
    "test:ocr": "node --test 04-rapidocr-child/smoke-test/ocr.test.js",
    "test:report": "node --test 05-report-core/smoke-test/report.test.js",
    "test:smtp": "node 06-qq-smtp/smoke-test/smtp-live.js",
    "test:feishu": "node 07-feishu-webhook/smoke-test/feishu-live.js",
    "test:scheduler": "node --test 08-windows-scheduler/smoke-test/scheduler.test.js && node 08-windows-scheduler/smoke-test/scheduler-live.js",
    "test:integration": "node --test 09-integration/smoke-test/integration.test.js",
    "test:offline": "npm run test:sqlite && npm run test:storage && npm run test:jobs && npm run test:ocr && npm run test:report && npm run test:integration",
