# AI StudyBuddy 使用机器非密钥配置模板
APP_DATA_ROOT=%LOCALAPPDATA%\AIStudyBuddy\data
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
FRONTEND_STATIC_ROOT=%LOCALAPPDATA%\AIStudyBuddy\app\backend\public
PYTHON_PATH=%LOCALAPPDATA%\AIStudyBuddy\runtime\venv\Scripts\python.exe
OCR_TIMEOUT_MS=60000
OCR_TEMP_ROOT=%LOCALAPPDATA%\AIStudyBuddy\tmp\ocr
OCR_CACHE_ROOT=%LOCALAPPDATA%\AIStudyBuddy\models\rapidocr
AI_TIMEOUT_MS=60000
CONFIG_ALLOWED_ORIGINS=
AI_PROVIDERS=
AI_BASE_URL=
AI_MODEL=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_TO=
FEISHU_WEBHOOK_URL=
