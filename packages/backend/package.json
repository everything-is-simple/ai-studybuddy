{
  "name": "@ai-studybuddy/backend",
  "version": "0.8.0",
  "type": "commonjs",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm run clean && tsc --build",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "clean": "node -e \"const fs=require(\\\"fs\\\"); for (const path of [\\\"dist\\\", \\\"tsconfig.tsbuildinfo\\\"]) fs.rmSync(path, { recursive: true, force: true });\"",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ai-studybuddy/shared": "workspace:*",
    "@types/multer": "^2.2.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
